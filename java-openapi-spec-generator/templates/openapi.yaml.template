# OpenAPI 3.0 specification TEMPLATE
# Replace the placeholders (<...>) with values from the Step 1 operation inventory.
# Keep this file as the source of truth at: src/main/resources/openapi/openapi.yaml
openapi: 3.0.3
info:
  title: <API title, e.g. Legacy Customer API>
  description: <Short description of what the API exposes>
  version: <API version, e.g. 1.0.0>
servers:
  - url: /<context-path, e.g. legacy-customer-api>
    description: Local server

paths:
  # ---- Example operation; duplicate/edit per documented endpoint ----
  /api/customers:
    get:
      summary: List all customers
      operationId: listCustomers
      responses:
        '200':
          description: A list of customers
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Customer'

  /api/customers/{id}:
    get:
      summary: Get customer information by id
      operationId: getCustomer
      parameters:
        - name: id
          in: path
          required: true
          description: Customer identifier
          schema:
            type: string
      responses:
        '200':
          description: Customer found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Customer'
        '404':
          description: Customer not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '503':
          description: Downstream customer system unavailable
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /api/customers/{id}/accounts:
    get:
      summary: List accounts for a customer
      operationId: getCustomerAccounts
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Accounts for the customer
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Account'
        '404':
          description: Customer not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /api/accounts/{accountId}:
    get:
      summary: Get account details
      operationId: getAccount
      parameters:
        - name: accountId
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: Account found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Account'
        '404':
          description: Account not found
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

components:
  schemas:
    Customer:
      type: object
      properties:
        customerId:
          type: string
        firstName:
          type: string
        lastName:
          type: string
        email:
          type: string
        phone:
          type: string
        status:
          type: string
          enum: [ACTIVE, SUSPENDED, CLOSED]
    Account:
      type: object
      properties:
        accountId:
          type: string
        customerId:
          type: string
        accountType:
          type: string
          enum: [CHECKING, SAVINGS, CREDIT]
        balance:
          type: number
          format: double
        currency:
          type: string
        status:
          type: string
          enum: [OPEN, FROZEN, CLOSED]
        openedDate:
          type: string
          format: date
    Error:
      type: object
      properties:
        error:
          type: boolean
        status:
          type: integer
          format: int32
        message:
          type: string
  # Uncomment if the API requires authentication:
  # securitySchemes:
  #   ApiKeyAuth:
  #     type: apiKey
  #     in: header
  #     name: X-API-Key
